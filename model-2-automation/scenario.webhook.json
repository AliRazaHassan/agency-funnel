{
  "name": "Agency Funnel — Lead to WhatsApp",
  "version": 1,
  "notes": "Rebuild these modules in Make.com UI. Webhook URL is generated by Make.",
  "modules": [
    {
      "id": 1,
      "type": "webhook",
      "name": "Fluent Forms catch",
      "expects": [
        "name",
        "whatsapp",
        "email",
        "business",
        "interest",
        "cta_variant",
        "source_keyword",
        "page_slug"
      ]
    },
    {
      "id": 2,
      "type": "openai.chat",
      "name": "Personalized proposal",
      "model": "gpt-4o-mini",
      "prompt_file": "openai-prompt.txt"
    },
    {
      "id": 3,
      "type": "http",
      "name": "Whapi send WhatsApp",
      "method": "POST",
      "url": "https://gate.whapi.cloud/messages/text",
      "auth": "Bearer {{WHAPI_TOKEN}}",
      "body": {
        "to": "{{whatsapp}}",
        "body": "{{openai_text}}"
      }
    },
    {
      "id": 4,
      "type": "google_sheets",
      "name": "Log lead",
      "action": "add_row"
    },
    {
      "id": 5,
      "type": "email",
      "name": "Notify owner",
      "optional": true
    }
  ]
}
