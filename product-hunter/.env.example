# Required on Render / production
APP_PASSWORD=change-me

# Cookie signing (auto-generated on Render if omitted locally)
SESSION_SECRET=dev-session-secret-change-me

# Optional — without it, seed research still works
OPENAI_API_KEY=

# Optional — only for ONE-TIME Amazon dump (then cancel)
# npm run keepa:pull -- B0XXXXXXXXX
# App normally uses free Wikimedia + optional keepa-snapshot.json
KEEPA_API_KEY=

# Optional — Meta Ad Library Graph API (ads only, not sales)
# META_AD_LIBRARY_TOKEN=

PORT=8787
NODE_ENV=development

# Same-organization Shopify Dev Dashboard app, installed on the target store.
# Grant only read_products,write_products for product draft creation.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Existing legacy integrations may use SHOPIFY_ADMIN_TOKEN instead.
# Do not commit live credentials or paste them into research inputs/chat.
