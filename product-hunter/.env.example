# Required on Render / production
APP_PASSWORD=change-me

# Cookie signing (auto-generated on Render if omitted locally)
SESSION_SECRET=dev-session-secret-change-me

# Optional — without it, seed research still works
OPENAI_API_KEY=

# Durable research/evidence/projects on Render (Key Value / Redis).
# Local: omit for file store in development. Production requires REDIS_URL or DATABASE_URL.
REDIS_URL=

# Optional — only for ONE-TIME Amazon dump (then cancel)
# npm run keepa:pull -- B0XXXXXXXXX
# App normally uses keepa-snapshot.json / manual paste; empty snapshot = Amazon UNAVAILABLE
KEEPA_API_KEY=

# Optional — Meta Ad Library Graph API (ads only, not sales). Alias: FACEBOOK_ACCESS_TOKEN
META_AD_LIBRARY_TOKEN=
# FACEBOOK_ACCESS_TOKEN=

# Optional — Apify FREE account token. Enables Automatic hunt for TikTok / Meta / Google Trends.
# Preferred cloud path when set. Never paste into research query fields.
APIFY_TOKEN=

# Direct unofficial Google Trends — OPT-IN for desk freeSignals AND evidence collect.
# Must be exactly "1" to enable. Unset/0 = direct Trends off (prefer Apify Automatic hunt on Render).
# ENABLE_GOOGLE_TRENDS=1
ENABLE_GOOGLE_TRENDS=

PORT=8787
NODE_ENV=development
