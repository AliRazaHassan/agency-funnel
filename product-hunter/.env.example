# Required on Render / production
APP_PASSWORD=change-me

# Cookie signing (auto-generated on Render if omitted locally)
SESSION_SECRET=dev-session-secret-change-me

# Optional — without it, seed research still works
OPENAI_API_KEY=

# Optional — only for ONE-TIME Amazon dump (then cancel)
# npm run keepa:pull -- B0XXXXXXXXX
# App normally uses free Wikimedia + optional keepa-snapshot.json
KEEPA_API_KEY=

# Optional — often blocked on cloud IPs
# ENABLE_GOOGLE_TRENDS=1

PORT=8787
NODE_ENV=development
